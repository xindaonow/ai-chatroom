{
  "name": "ai-chatroom",
  "version": "0.0.1",
  "description": "Ask multiple AI models, let them see each other's responses, and watch them compare, challenge, and converge.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev:server": "PORT=3001 bun run --watch src/server/index.ts",
    "dev:web": "vite",
    "dev": "bun run dev:server & bun run dev:web",
    "build:web": "vite build",
    "start": "bun run src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify:fast": "bun run typecheck && bun test --silent",
    "verify:visibility": "bun test src/server/visibility",
    "verify:adapters": "bun test src/server/adapters",
    "verify:e2e": "bun run scripts/verify-e2e.ts",
    "verify:cache": "bun run scripts/verify-cache.ts",
    "verify": "bun run verify:fast && bun run verify:visibility && bun run verify:adapters && bun run verify:e2e"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "ai": "^6.0.168",
    "hono": "^4.6.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
