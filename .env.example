# Copy to `.env.local` and fill in the values. `.env.local` is gitignored.
#
# At minimum: set OPENROUTER_API_KEY. Everything else is optional.

# REQUIRED — your OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# OPTIONAL — Volcengine ARK key, only needed if you use a `doubao/...` model.
# Get one at https://www.volcengine.com/product/ark
# ARK_API_KEY=

# OPTIONAL — restrict CORS to specific origins (comma-separated).
# Defaults to localhost:5173 / 127.0.0.1:5173 for the Vite dev server.
# DO NOT set this to "*" on a public deployment.
# CORS_ORIGINS=http://localhost:5173,https://your-domain.example

# OPTIONAL — disable TLS certificate verification on outbound fetches.
# Workaround for Bun on macOS occasionally failing on openrouter.ai.
# LOCAL DEVELOPMENT ONLY — never enable on a public server.
# INSECURE_TLS=1

# OPTIONAL — override SQLite path. Defaults to ./data/dev.db
# DB_PATH=./data/custom.db

# OPTIONAL — override server port. Defaults to 3000.
# PORT=3000
